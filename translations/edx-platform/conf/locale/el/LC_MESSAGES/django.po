#: xmodule/item_bank_block.py:64 xmodule/library_content_block.py:94
msgid "Count"
msgstr "Πλήθος"

#: xmodule/item_bank_block.py:65 xmodule/library_content_block.py:95
msgid ""
"Enter the number of components to display to each student. Set it to -1 to "
"display all components."
msgstr ""
"Εισάγετε τον αριθμό των στοιχείων που θα εμφανίζονται σε κάθε φοιτητή. "
"Ορίστε το σε -1 για να εμφανίσετε όλα τα στοιχεία."

#: xmodule/item_bank_block.py:78
msgid ""
"Determines whether a 'Reset Problems' button is shown, so users may reset "
"their answers and reshuffle selected items."
msgstr ""
"Καθορίζει εάν εμφανίζεται ένα κουμπί 'Επαναφορά προβλημάτων', ώστε οι "
"χρήστες να μπορούν να επαναφέρουν τις απαντήσεις τους και να ανακατέψουν τα "
"επιλεγμένα στοιχεία."

#: xmodule/item_bank_block.py:471
#, python-brace-format
msgid ""
"The problem bank has been configured to show {count} problems. Please "
"specify a positive number of problems, or specify -1 to show all problems."
msgstr ""
"Η τράπεζα προβλημάτων έχει ρυθμιστεί να εμφανίζει {count} προβλήματα. "
"Παρακαλούμε καθορίστε έναν θετικό αριθμό προβλημάτων ή καθορίστε -1 για να "
"εμφανίσετε όλα τα προβλήματα."

#: xmodule/item_bank_block.py:475 xmodule/item_bank_block.py:487
msgid "Edit the problem bank configuration."
msgstr "Επεξεργασία της διαμόρφωσης της τράπεζας προβλημάτων."

#: xmodule/item_bank_block.py:483
#, python-brace-format
msgid ""
"The problem bank has been configured to show {count} problems, but only "
"{actual} have been selected."
msgstr ""
"Η τράπεζα προβλημάτων έχει ρυθμιστεί να εμφανίζει {count} προβλήματα, αλλά "
"έχουν επιλεγεί μόνο {actual}."

#: xmodule/library_content_block.py:51
msgid "Any Type"
msgstr "Οποιοσδήποτε τύπος"

#: xmodule/library_content_block.py:83 cms/templates/widgets/header.html:285
msgid "Library"
msgstr "Βιβλιοθήκη"

#: xmodule/library_content_block.py:84
msgid "Select the library from which you want to draw content."
msgstr "Επιλέξτε τη βιβλιοθήκη από την οποία θέλετε να αντλήσετε περιεχόμενο."

#: xmodule/library_content_block.py:90
msgid "Library Version"
msgstr "Έκδοση βιβλιοθήκης"

#: xmodule/library_content_block.py:100
msgid "Problem Type"
msgstr "Τύπος προβλήματος"

#: xmodule/library_content_block.py:101
msgid ""
"Choose a problem type to fetch from the library. If \"Any Type\" is selected "
"no filtering is applied."
msgstr ""
"Επιλέξτε έναν τύπο προβλήματος για ανάκτηση από τη βιβλιοθήκη. Εάν έχει "
"επιλεγεί \"Οποιοσδήποτε Τύπος\", δεν εφαρμόζεται φιλτράρισμα."

#: xmodule/library_content_block.py:200
msgid "Source content library has not been specified."
msgstr "Η βιβλιοθήκη περιεχομένου πηγής δεν έχει καθοριστεί."

#: xmodule/library_content_block.py:204
msgid "Content libraries are not available in the current runtime."
msgstr ""
"Οι βιβλιοθήκες περιεχομένου δεν είναι διαθέσιμες στην τρέχουσα εκτέλεση."

#: xmodule/library_content_block.py:207
#, python-brace-format
msgid "Source content library does not exist: {source_library_id}"
msgstr "Η βιβλιοθήκη περιεχομένου πηγής δεν υπάρχει: {source_library_id}"

#: xmodule/library_content_block.py:273
msgid "This component is out of date. The library has new content."
msgstr "Αυτό το στοιχείο είναι παρωχημένο. Η βιβλιοθήκη έχει νέο περιεχόμενο."

#. Translators: {refresh_icon} placeholder αντικαθίσταται από "↻" (χωρίς
#. διπλά εισαγωγικά)
#: xmodule/library_content_block.py:278
#, python-brace-format
msgid "{refresh_icon} Update now."
msgstr "{refresh_icon} Ενημέρωση τώρα."

#: xmodule/library_content_block.py:286
msgid "Library is invalid, corrupt, or has been deleted."
msgstr "Η βιβλιοθήκη είναι μη έγκυρη, κατεστραμμένη ή έχει διαγραφεί."

#: xmodule/library_content_block.py:288
msgid "Edit Library List."
msgstr "Επεξεργασία λίστας βιβλιοθήκης."

#: xmodule/library_content_block.py:315
msgid ""
"This course does not support content libraries. Contact your system "
"administrator for more information."
msgstr ""
"Αυτό το μάθημα δεν υποστηρίζει βιβλιοθήκες περιεχομένου. Επικοινωνήστε με "
"τον διαχειριστή του συστήματός σας για περισσότερες πληροφορίες."

#: xmodule/library_content_block.py:325
msgid "A library has not yet been selected."
msgstr "Δεν έχει επιλεγεί ακόμη βιβλιοθήκη."

#: xmodule/library_content_block.py:327
msgid "Select a Library."
msgstr "Επιλέξτε μια βιβλιοθήκη."

#: xmodule/library_content_block.py:341
#, python-brace-format
msgid "There are no problems in the specified library of type {capa_type}."
msgstr ""
"Δεν υπάρχουν προβλήματα στην καθορισμένη βιβλιοθήκη του τύπου {capa_type}."

#: xmodule/library_content_block.py:344
msgid "Select another problem type."
msgstr "Επιλέξτε έναν άλλο τύπο προβλήματος."

#: xmodule/library_content_block.py:355
#, python-brace-format
msgid "The specified library is configured to fetch {count} problem, "
msgid_plural "The specified library is configured to fetch {count} problems, "
msgstr[0] "Η καθορισμένη βιβλιοθήκη έχει ρυθμιστεί να ανακτά {count} πρόβλημα,"
msgstr[1] ""
"Η καθορισμένη βιβλιοθήκη έχει ρυθμιστεί να ανακτά {count} προβλήματα,"

#: xmodule/library_content_block.py:360
#, python-brace-format
msgid "but there is only {actual} matching problem."
msgid_plural "but there are only {actual} matching problems."
msgstr[0] "αλλά υπάρχει μόνο {actual} αντίστοιχο πρόβλημα."
msgstr[1] "αλλά υπάρχουν μόνο {actual} αντίστοιχα προβλήματα."

#: xmodule/library_content_block.py:366
msgid "Edit the library configuration."
msgstr "Επεξεργασία της διαμόρφωσης της βιβλιοθήκης."

#: xmodule/library_content_block.py:384
msgid "Invalid Library"
msgstr "Μη έγκυρη βιβλιοθήκη"

#: xmodule/library_content_block.py:385
msgid "No Library Selected"
msgstr "Δεν έχει επιλεγεί βιβλιοθήκη"

#: xmodule/library_root_xblock.py:32
msgid "Library Display Name"
msgstr "Όνομα εμφάνισης βιβλιοθήκης"

#: xmodule/library_root_xblock.py:37
msgid "Enter the names of the advanced components to use in your library."
msgstr ""
"Εισάγετε τα ονόματα των προηγμένων στοιχείων που θα χρησιμοποιήσετε στη "
"βιβλιοθήκη σας."

#: xmodule/lti_block.py:133
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"Το όνομα εμφάνισης για αυτό το στοιχείο. Οι αναφορές αναλυτικών στοιχείων "
"ενδέχεται επίσης να χρησιμοποιούν το όνομα εμφάνισης για να προσδιορίσουν "
"αυτό το στοιχείο."

#: xmodule/lti_block.py:140
msgid "LTI ID"
msgstr "Αναγνωριστικό LTI"

#: xmodule/lti_block.py:142
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same "
"LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Εισάγετε το αναγνωριστικό LTI για τον εξωτερικό πάροχο LTI. Αυτή η τιμή "
"πρέπει να είναι το ίδιο αναγνωριστικό LTI που εισάγατε στη ρύθμιση LTI "
"Passports στη σελίδα Προχωρημένες Ρυθμίσεις.{break_tag}Δείτε "
"{docs_anchor_open}την τεκμηρίωση LTI του edX{anchor_close} για περισσότερες "
"λεπτομέρειες σχετικά με αυτή τη ρύθμιση."

#: xmodule/lti_block.py:155
msgid "LTI URL"
msgstr "Διεύθυνση URL LTI"

#: xmodule/lti_block.py:157
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"Εισάγετε τη διεύθυνση URL του εξωτερικού εργαλείου που εκκινεί αυτό το "
"στοιχείο. Αυτή η ρύθμιση χρησιμοποιείται μόνο όταν το Hide External Tool "
"έχει οριστεί σε False.{break_tag}Δείτε {docs_anchor_open}την τεκμηρίωση LTI "
"του edX{anchor_close} για περισσότερες λεπτομέρειες σχετικά με αυτή τη "
"ρύθμιση."

#: xmodule/lti_block.py:168
msgid "Custom Parameters"
msgstr "Προσαρμοσμένες παράμετροι"

#: xmodule/lti_block.py:170
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your e-"
"book should open to or the background color for this component.{break_tag}"
"See {docs_anchor_open}the edX LTI documentation{anchor_close} for more "
"details on this setting."
msgstr ""
"Προσθέστε το ζεύγος κλειδιού/τιμής για τυχόν προσαρμοσμένες παραμέτρους, "
"όπως τη σελίδα στην οποία πρέπει να ανοίξει το ηλεκτρονικό σας βιβλίο ή το "
"χρώμα φόντου για αυτό το στοιχείο.{break_tag}Δείτε {docs_anchor_open}την "
"τεκμηρίωση LTI του edX{anchor_close} για περισσότερες λεπτομέρειες σχετικά "
"με αυτή τη ρύθμιση."

#: xmodule/lti_block.py:180
msgid "Open in New Page"
msgstr "Άνοιγμα σε νέα σελίδα"

#: xmodule/lti_block.py:182
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"Επιλέξτε True εάν θέλετε οι φοιτητές να κάνουν κλικ σε έναν σύνδεσμο που "
"ανοίγει το εργαλείο LTI σε ένα νέο παράθυρο. Επιλέξτε False εάν θέλετε το "
"περιεχόμενο LTI να ανοίγει σε ένα IFrame στην τρέχουσα σελίδα. Αυτή η "
"ρύθμιση χρησιμοποιείται μόνο όταν το Hide External Tool έχει οριστεί σε "
"False."

#: xmodule/lti_block.py:190
msgid "Scored"
msgstr "Βαθμολογήθηκε"

#: xmodule/lti_block.py:192
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Επιλέξτε True εάν αυτό το στοιχείο θα λάβει αριθμητική βαθμολογία από το "
"εξωτερικό σύστημα LTI."

#: xmodule/lti_block.py:198
msgid "Weight"
msgstr "Βάρος"

#: xmodule/lti_block.py:200
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Εισάγετε τον αριθμό των πιθανών πόντων για αυτό το στοιχείο. Η προεπιλεγμένη "
"τιμή είναι 1.0. Αυτή η ρύθμιση χρησιμοποιείται μόνο όταν το Scored έχει "
"οριστεί σε True."

#: xmodule/lti_block.py:209
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"Η βαθμολογία που διατηρείται στο xblock KVS -- αντίγραφο της δημοσιευμένης "
"βαθμολογίας στη βάση δεδομένων django"

#: xmodule/lti_block.py:214
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "Σχόλιο όπως επιστράφηκε από τον βαθμολογητή, προδιαγραφή LTI2.0"

#: xmodule/lti_block.py:219
msgid "Hide External Tool"
msgstr "Απόκρυψη εξωτερικού εργαλείου"

#: xmodule/lti_block.py:221
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Επιλέξτε True εάν θέλετε να χρησιμοποιήσετε αυτό το στοιχείο ως σύμβολο "
"κράτησης θέσης για συγχρονισμό με ένα εξωτερικό σύστημα βαθμολόγησης αντί να "
"εκκινήσετε ένα εξωτερικό εργαλείο. Αυτή η ρύθμιση αποκρύπτει το κουμπί "
"εκκίνησης και οποιαδήποτε IFrames για αυτό το στοιχείο."

#: xmodule/lti_block.py:232
msgid "Request user's username"
msgstr "Αίτημα ονόματος χρήστη"

#. Translators: Αυτό χρησιμοποιείται για να ζητήσει το όνομα χρήστη του χρήστη για
#. μια υπηρεσία τρίτου μέρους.
#: xmodule/lti_block.py:234
msgid "Select True to request the user's username."
msgstr "Επιλέξτε True για να ζητήσετε το όνομα χρήστη του χρήστη."

#: xmodule/lti_block.py:239
msgid "Request user's email"
msgstr "Αίτημα email χρήστη"

#. Translators: Αυτό χρησιμοποιείται για να ζητήσει το email του χρήστη για μια
#. υπηρεσία τρίτου μέρους.
#: xmodule/lti_block.py:241
msgid "Select True to request the user's email address."
msgstr "Επιλέξτε True για να ζητήσετε τη διεύθυνση email του χρήστη."

#: xmodule/lti_block.py:247
msgid "LTI Application Information"
msgstr "Πληροφορίες εφαρμογής LTI"

#: xmodule/lti_block.py:249
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Εισάγετε μια περιγραφή της εφαρμογής τρίτου μέρους. Εάν ζητάτε όνομα χρήστη "
"ή/και email, χρησιμοποιήστε αυτό το πλαίσιο κειμένου για να ενημερώσετε τους "
"χρήστες γιατί το όνομα χρήστη ή/και το email τους θα προωθηθεί σε εφαρμογή "
"τρίτου μέρους."

#: xmodule/lti_block.py:257
msgid "Button Text"
msgstr "Κείμενο κουμπιού"

#: xmodule/lti_block.py:259
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr ""
"Εισάγετε το κείμενο στο κουμπί που χρησιμοποιείται για την εκκίνηση της "
"εφαρμογής τρίτου μέρους."

#: xmodule/lti_block.py:266
msgid "Accept grades past deadline"
msgstr "Αποδοχή βαθμών μετά την προθεσμία"

#: xmodule/lti_block.py:267
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Επιλέξτε True για να επιτρέψετε σε συστήματα τρίτων να δημοσιεύουν βαθμούς "
"μετά την προθεσμία."

#: xmodule/lti_block.py:440
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"Δεν ήταν δυνατή η ανάλυση της προσαρμοσμένης παραμέτρου: {custom_parameter}. "
"Θα έπρεπε να είναι συμβολοσειρά \"x=y\"."

#: xmodule/lti_block.py:968
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"Δεν ήταν δυνατή η ανάλυση του διαβατηρίου LTI: {lti_passport}. Θα έπρεπε να "
"είναι συμβολοσειρά \"id:key:secret\"."

#: xmodule/modulestore/inheritance.py:47 xmodule/seq_block.py:78
#: lms/templates/ccx/schedule.html:115
msgid "Due Date"
msgstr "Προθεσμία"

#: xmodule/modulestore/inheritance.py:48
msgid "Enter the default date by which problems are due."
msgstr "Εισάγετε την προεπιλεγμένη ημερομηνία λήξης για τα προβλήματα."

#: xmodule/modulestore/inheritance.py:53 xmodule/seq_block.py:84
msgid "Number of Relative Weeks Due By"
msgstr "Αριθμός σχετικών εβδομάδων λήξης"

#: xmodule/modulestore/inheritance.py:54 xmodule/seq_block.py:85
msgid ""
"Enter the number of weeks the problems are due by relative to the learner's "
"enrollment date"
msgstr ""
"Εισάγετε τον αριθμό των εβδομάδων που λήγουν τα προβλήματα σε σχέση με την "
"ημερομηνία εγγραφής του μαθητή"

#: xmodule/modulestore/inheritance.py:70
msgid "GIT URL"
msgstr "Διεύθυνση URL GIT"

#: xmodule/modulestore/inheritance.py:71
msgid "Enter the URL for the course data GIT repository."
msgstr "Εισάγετε τη διεύθυνση URL για το αποθετήριο δεδομένων μαθήματος GIT."

#: xmodule/modulestore/inheritance.py:75
msgid "XQA Key"
msgstr "Κλειδί XQA"

#: xmodule/modulestore/inheritance.py:76
msgid "This setting is not currently supported."
msgstr "Αυτή η ρύθμιση δεν υποστηρίζεται προς το παρόν."

#: xmodule/modulestore/inheritance.py:84
msgid "Enter the ids for the content groups this problem belongs to."
msgstr ""
"Εισάγετε τα αναγνωριστικά για τις ομάδες περιεχομένου στις οποίες ανήκει "
"αυτό το πρόβλημα."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:93
msgid ""
"Specify when the Show Answer button appears for each problem. Valid values "
"are \"always\", \"answered\", \"attempted\", \"closed\", \"finished\", "
"\"past_due\", \"correct_or_past_due\", \"after_all_attempts\", "
"\"after_all_attempts_or_correct\", \"attempted_no_past_due\", and \"never\"."
msgstr ""
"Καθορίστε πότε εμφανίζεται το κουμπί \"Εμφάνιση απάντησης\" για κάθε "
"πρόβλημα. Οι έγκυρες τιμές είναι \"always\", \"answered\", \"attempted\", "
"\"closed\", \"finished\", \"past_due\", \"correct_or_past_due\", "
"\"after_all_attempts\", \"after_all_attempts_or_correct\", "
"\"attempted_no_past_due\" και \"never\"."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:107
msgid ""
"Specify when to show answer correctness and score to learners. Valid values "
"are \"always\", \"never\", and \"past_due\"."
msgstr ""
"Καθορίστε πότε θα εμφανίζεται η ορθότητα και η βαθμολογία της απάντησης "
"στους εκπαιδευόμενους. Οι έγκυρες τιμές είναι \"πάντα\", \"ποτέ\" και "
"\"παρελθούσα προθεσμία\"."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:119
msgid ""
"Specify the default for how often variable values in a problem are "
"randomized. This setting should be set to \"never\" unless you plan to "
"provide a Python script to identify and randomize values in most of the "
"problems in your course. Valid values are \"always\", \"onreset\", "
"\"never\", and \"per_student\"."
msgstr ""
"Καθορίστε την προεπιλογή για το πόσο συχνά τυχαιοποιούνται οι τιμές "
"μεταβλητών σε ένα πρόβλημα. Αυτή η ρύθμιση θα πρέπει να οριστεί σε \"ποτέ\" "
"εκτός εάν σκοπεύετε να παρέχετε ένα σενάριο Python για την αναγνώριση και "
"τυχαιοποίηση τιμών στα περισσότερα προβλήματα του μαθήματός σας. Οι έγκυρες "
"τιμές είναι \"πάντα\", \"στην επαναφορά\", \"ποτέ\" και \"ανά φοιτητή\"."

#: xmodule/modulestore/inheritance.py:128
msgid "Days Early for Beta Users"
msgstr "Πρώιμες ημέρες για χρήστες Beta"

#: xmodule/modulestore/inheritance.py:129
msgid ""
"Enter the number of days before the start date that beta users can access "
"the course."
msgstr ""
"Εισάγετε τον αριθμό ημερών πριν από την ημερομηνία έναρξης κατά τις οποίες "
"οι χρήστες beta μπορούν να έχουν πρόσβαση στο μάθημα."

#: xmodule/modulestore/inheritance.py:134
msgid "Static Asset Path"
msgstr "Διαδρομή στατικού πόρου"

#: xmodule/modulestore/inheritance.py:135
msgid ""
"Enter the path to use for files on the Files & Uploads page. This value "
"overrides the Studio default, c4x://."
msgstr ""
"Εισάγετε τη διαδρομή που θα χρησιμοποιηθεί για αρχεία στη σελίδα Αρχεία & "
"Μεταφορτώσεις. Αυτή η τιμή αντικαθιστά την προεπιλογή του Studio, c4x://."

#: xmodule/modulestore/inheritance.py:140
msgid "Enable LaTeX Compiler"
msgstr "Ενεργοποίηση μεταγλωττιστή LaTeX"

#: xmodule/modulestore/inheritance.py:141
msgid ""
"Enter true or false. If true, you can use the LaTeX templates for HTML "
"components and advanced Problem components."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, μπορείτε να χρησιμοποιήσετε τα πρότυπα "
"LaTeX για στοιχεία HTML και προχωρημένα στοιχεία προβλημάτων."

#: xmodule/modulestore/inheritance.py:147
msgid ""
"Enter the maximum number of times a student can try to answer problems. By "
"default, Maximum Attempts is set to null, meaning that students have an "
"unlimited number of attempts for problems. You can override this course-wide "
"setting for individual problems. However, if the course-wide setting is a "
"specific number, you cannot set the Maximum Attempts for individual problems "
"to unlimited."
msgstr ""
"Εισάγετε τον μέγιστο αριθμό φορών που ένας φοιτητής μπορεί να προσπαθήσει να "
"απαντήσει σε προβλήματα. Από προεπιλογή, το Μέγιστες Προσπάθειες ορίζεται σε "
"null, πράγμα που σημαίνει ότι οι φοιτητές έχουν απεριόριστο αριθμό "
"προσπαθειών για προβλήματα. Μπορείτε να παρακάμψετε αυτή τη ρύθμιση για όλο "
"το μάθημα για μεμονωμένα προβλήματα. Ωστόσο, εάν η ρύθμιση για όλο το μάθημα "
"είναι ένας συγκεκριμένος αριθμός, δεν μπορείτε να ορίσετε τις Μέγιστες "
"Προσπάθειες για μεμονωμένα προβλήματα σε απεριόριστες."

#: xmodule/modulestore/inheritance.py:152
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use in this course for the "
"specified duration. Do not share the API key with other courses. Notify "
"MathWorks immediately if you believe the key is exposed or compromised. To "
"obtain a key for your course, or to report an issue, please contact "
"moocsupport@mathworks.com"
msgstr ""
"Εισάγετε το κλειδί API που παρέχεται από τη MathWorks για την πρόσβαση στην "
"Υπηρεσία MATLAB Hosted. Αυτό το κλειδί χορηγείται για αποκλειστική χρήση σε "
"αυτό το μάθημα για τη συγκεκριμένη διάρκεια. Μην μοιράζεστε το κλειδί API με "
"άλλα μαθήματα. Ειδοποιήστε αμέσως τη MathWorks εάν πιστεύετε ότι το κλειδί "
"έχει εκτεθεί ή παραβιαστεί. Για να αποκτήσετε ένα κλειδί για το μάθημά σας ή "
"για να αναφέρετε ένα ζήτημα, παρακαλούμε επικοινωνήστε με το "
"moocsupport@mathworks.com"

#: xmodule/modulestore/inheritance.py:162 cms/templates/certificates.html:119
#: cms/templates/group_configurations.html:17
#: cms/templates/group_configurations.html:46 cms/templates/settings.html:709
#: cms/templates/settings_advanced.html:149
#: cms/templates/settings_graders.html:171
#: cms/templates/widgets/header.html:193
msgid "Group Configurations"
msgstr "Διαμορφώσεις ομάδων"

#: xmodule/modulestore/inheritance.py:163
msgid "Enter the configurations that govern how students are grouped together."
msgstr ""
"Εισάγετε τις διαμορφώσεις που καθορίζουν τον τρόπο ομαδοποίησης των φοιτητών."

#: xmodule/modulestore/inheritance.py:168
msgid "Enable video caching system"
msgstr "Ενεργοποίηση συστήματος προσωρινής αποθήκευσης βίντεο"

#: xmodule/modulestore/inheritance.py:169
msgid ""
"Enter true or false. If true, video caching will be used for HTML5 videos."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, η προσωρινή αποθήκευση βίντεο θα "
"χρησιμοποιηθεί για βίντεο HTML5."

#: xmodule/modulestore/inheritance.py:174
msgid "Enable video auto-advance"
msgstr "Ενεργοποίηση αυτόματης προώθησης βίντεο"

#: xmodule/modulestore/inheritance.py:176
msgid ""
"Specify whether to show an auto-advance button in videos. If the student "
"clicks it, when the last video in a unit finishes it will automatically move "
"to the next unit and autoplay the first video."
msgstr ""
"Καθορίστε εάν θα εμφανίζεται ένα κουμπί αυτόματης προώθησης στα βίντεο. Εάν "
"ο φοιτητής κάνει κλικ σε αυτό, όταν το τελευταίο βίντεο σε μια ενότητα "
"τελειώσει, θα μετακινηθεί αυτόματα στην επόμενη ενότητα και θα αναπαραχθεί "
"αυτόματα το πρώτο βίντεο."

#: xmodule/modulestore/inheritance.py:182
msgid "Video Pre-Roll"
msgstr "Προ-αναπαραγωγή βίντεο"

#: xmodule/modulestore/inheritance.py:184
#, python-brace-format
msgid ""
"Identify a video, 5-10 seconds in length, to play before course videos. "
"Enter the video ID from the Video Uploads page and one or more transcript "
"files in the following format: {format}. For example, an entry for a video "
"with two transcripts looks like this: {example}"
msgstr ""
"Προσδιορίστε ένα βίντεο, διάρκειας 5-10 δευτερολέπτων, για αναπαραγωγή πριν "
"από τα βίντεο του μαθήματος. Εισάγετε το αναγνωριστικό βίντεο από τη σελίδα "
"Μεταφορτώσεις βίντεο και ένα ή περισσότερα αρχεία υποτίτλων στην ακόλουθη "
"μορφή: {format}. Για παράδειγμα, μια καταχώριση για ένα βίντεο με δύο "
"υποτίτλους μοιάζει με αυτό: {example}"

#: xmodule/modulestore/inheritance.py:201
msgid "Show Reset Button for Problems"
msgstr "Εμφάνιση κουμπιού επαναφοράς για προβλήματα"

#: xmodule/modulestore/inheritance.py:203
msgid ""
"Enter true or false. If true, problems in the course default to always "
"displaying a 'Reset' button. You can override this in each problem's "
"settings. All existing problems are affected when this course-wide setting "
"is changed."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, τα προβλήματα στο μάθημα εμφανίζουν εξ "
"ορισμού ένα κουμπί 'Επαναφορά'. Μπορείτε να το παρακάμψετε αυτό στις "
"ρυθμίσεις κάθε προβλήματος. Όλα τα υπάρχοντα προβλήματα επηρεάζονται όταν "
"αλλάζει αυτή η ρύθμιση σε επίπεδο μαθήματος."

#: xmodule/modulestore/inheritance.py:211
msgid "Enable Student Notes"
msgstr "Ενεργοποίηση σημειώσεων φοιτητών"

#: xmodule/modulestore/inheritance.py:212
msgid ""
"Enter true or false. If true, students can use the Student Notes feature."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, οι φοιτητές μπορούν να χρησιμοποιούν "
"τη λειτουργία Σημειώσεις Φοιτητών."

#: xmodule/modulestore/inheritance.py:218
msgid ""
"Indicates whether Student Notes are visible in the course. Students can also "
"show or hide their notes in the courseware."
msgstr ""
"Υποδεικνύει εάν οι Σημειώσεις Φοιτητών είναι ορατές στο μάθημα. Οι φοιτητές "
"μπορούν επίσης να εμφανίσουν ή να αποκρύψουν τις σημειώσεις τους στο "
"λογισμικό του μαθήματος."

#: xmodule/modulestore/inheritance.py:225
msgid "Tag this block as part of an Entrance Exam section"
msgstr "Σημάνετε αυτό το μπλοκ ως μέρος μιας ενότητας εισαγωγικών εξετάσεων"

#: xmodule/modulestore/inheritance.py:226
msgid ""
"Enter true or false. If true, answer submissions for problem blocks will be "
"considered in the Entrance Exam scoring/gating algorithm."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, οι υποβολές απαντήσεων για μπλοκ "
"προβλημάτων θα ληφθούν υπόψη στον αλγόριθμο βαθμολόγησης/φραγμού της "
"Εισαγωγικής Εξέτασης."

#: xmodule/modulestore/inheritance.py:244
msgid "Hide from Table of Contents"
msgstr "Απόκρυψη από τον Πίνακα Περιεχομένων"

#: xmodule/modulestore/inheritance.py:245
msgid ""
"Enter true or false. If true, this block will be hidden from the Table of "
"Contents."
msgstr ""
"Εισάγετε αληθές ή ψευδές. Εάν αληθές, αυτό το μπλοκ θα αποκρυφθεί από τον "
"πίνακα περιεχομένων."

#: xmodule/modulestore/xml_importer.py:79
msgid "Error while reading {}. Check file for XML errors."
msgstr "Σφάλμα κατά την ανάγνωση {}. Ελέγξτε το αρχείο για σφάλματα XML."

#: xmodule/modulestore/xml_importer.py:91
msgid "Failed to import block: {} at location: {}"
msgstr "Αποτυχία εισαγωγής μπλοκ: {} στην τοποθεσία: {}"

#: xmodule/partitions/enrollment_track_partition_generator.py:38
#: cms/templates/group_configurations.html:86
msgid "Enrollment Track Groups"
msgstr "Ομάδες διαδρομής εγγραφής"

#: xmodule/partitions/enrollment_track_partition_generator.py:39
msgid "Partition for segmenting users by enrollment track"
msgstr "Διαχωρισμός για την ομαδοποίηση των χρηστών ανά διαδρομή εγγραφής"

#: xmodule/poll_block.py:54
msgid "Whether this student has voted on the poll"
msgstr "Εάν αυτός ο φοιτητής έχει ψηφίσει στην δημοσκόπηση"

#: xmodule/poll_block.py:59
msgid "Student answer"
msgstr "Απάντηση φοιτητή"

#: xmodule/poll_block.py:64
msgid "Poll answers from all students"
msgstr "Απαντήσεις δημοσκόπησης από όλους τους φοιτητές"

#: xmodule/poll_block.py:70
msgid "Poll answers from xml"
msgstr "Απαντήσεις δημοσκόπησης από xml"

#: xmodule/poll_block.py:76
msgid "Poll question"
msgstr "Ερώτηση δημοσκόπησης"

#: xmodule/seq_block.py:79
msgid "Enter the date by which problems are due."
msgstr "Εισάγετε την ημερομηνία λήξης για τα προβλήματα."

#: xmodule/seq_block.py:90
msgid "Hide sequence content After Due Date"
msgstr "Απόκρυψη περιεχομένου ακολουθίας μετά την προθεσμία"

#: xmodule/seq_block.py:92
msgid ""
"If set, the sequence content is hidden for non-staff users after the due "
"date has passed."
msgstr ""
"Εάν έχει οριστεί, το περιεχόμενο της ακολουθίας αποκρύπτεται από τους "
"χρήστες που δεν είναι προσωπικό, μετά την πάροδο της προθεσμίας."

#: xmodule/seq_block.py:99
msgid "Is Entrance Exam"
msgstr "Είναι εισαγωγική εξέταση"

#: xmodule/seq_block.py:101
msgid ""
"Tag this course block as an Entrance Exam. Note, you must enable Entrance "
"Exams for this course setting to take effect."
msgstr ""
"Σημάνετε αυτό το μπλοκ μαθήματος ως Εισαγωγική Εξέταση. Σημειώστε ότι πρέπει "
"να ενεργοποιήσετε τις Εισαγωγικές Εξετάσεις για να τεθεί σε ισχύ αυτή η "
"ρύθμιση μαθήματος."

#: xmodule/seq_block.py:152
msgid "Is Time Limited"
msgstr "Είναι χρονικά περιορισμένο"

#: xmodule/seq_block.py:154
msgid ""
"This setting indicates whether students have a limited time to view or "
"interact with this courseware component."
msgstr ""
"Αυτή η ρύθμιση υποδεικνύει εάν οι φοιτητές έχουν περιορισμένο χρόνο για να "
"δουν ή να αλληλεπιδράσουν με αυτό το στοιχείο λογισμικού μαθήματος."

#: xmodule/seq_block.py:162
msgid "Time Limit in Minutes"
msgstr "Χρονικό όριο σε λεπτά"

#: xmodule/seq_block.py:164
msgid ""
"The number of minutes available to students for viewing or interacting with "
"this courseware component."
msgstr ""
"Ο αριθμός των λεπτών που είναι διαθέσιμα στους φοιτητές για την προβολή ή "
"την αλληλεπίδραση με αυτό το στοιχείο λογισμικού μαθήματος."

#: xmodule/seq_block.py:171
msgid "Is Proctoring Enabled"
msgstr "Είναι ενεργοποιημένη η επίβλεψη"

#: xmodule/seq_block.py:173
msgid "This setting indicates whether this exam is a proctored exam."
msgstr ""
"Αυτή η ρύθμιση υποδεικνύει εάν αυτή η εξέταση είναι εξέταση με επίβλεψη."

#: xmodule/seq_block.py:180
msgid "Software Secure Review Rules"
msgstr "Κανόνες ασφαλούς αναθεώρησης λογισμικού"

#: xmodule/seq_block.py:182
msgid ""
"This setting indicates what rules the proctoring team should follow when "
"viewing the videos."
msgstr ""
"Αυτή η ρύθμιση υποδεικνύει ποιους κανόνες πρέπει να ακολουθεί η ομάδα "
"επίβλεψης κατά την προβολή των βίντεο."

#: xmodule/seq_block.py:189
msgid "Is Practice Exam"
msgstr "Είναι δοκιμαστική εξέταση"

#: xmodule/seq_block.py:191
msgid ""
"This setting indicates whether this exam is for testing purposes only. "
"Practice exams are not verified."
msgstr ""
"Αυτή η ρύθμιση υποδεικνύει εάν αυτή η εξέταση είναι μόνο για δοκιμαστικούς "
"σκοπούς. Οι πρακτικές εξετάσεις δεν επαληθεύονται."

#: xmodule/seq_block.py:198
msgid "Is Onboarding Exam"
msgstr "Είναι εξέταση προσαρμογής"

#: xmodule/seq_block.py:200
msgid "This setting indicates whether this exam is an onboarding exam."
msgstr ""
"Αυτή η ρύθμιση υποδεικνύει εάν αυτή η εξέταση είναι μια εξέταση προσαρμογής."

#: xmodule/seq_block.py:358 xmodule/seq_block.py:450
msgid ""
"This subsection is unlocked for learners when they meet the prerequisite "
"requirements."
msgstr ""
"Αυτή η υποενότητα ξεκλειδώνεται για τους μαθητές όταν πληρούν τις "
"προαπαιτούμενες απαιτήσεις."

#: xmodule/seq_block.py:502
msgid "This exam is hidden from the learner."
msgstr "Αυτή η εξέταση είναι κρυφή από τον μαθητή."

#: xmodule/seq_block.py:511
msgid ""
"Because the course has ended, this assignment is hidden from the learner."
msgstr ""
"Επειδή το μάθημα έχει ολοκληρωθεί, αυτή η εργασία είναι κρυφή από τον μαθητή."

#: xmodule/seq_block.py:513
msgid ""
"Because the due date has passed, this assignment is hidden from the learner."
msgstr ""
"Επειδή η προθεσμία έχει παρέλθει, αυτή η εργασία είναι κρυφή από τον μαθητή."

#: xmodule/seq_block.py:557
msgid ""
"This section is a prerequisite. You must complete this section in order to "
"unlock additional content."
msgstr ""
"Αυτή η ενότητα είναι προαπαιτούμενο. Πρέπει να ολοκληρώσετε αυτή την ενότητα "
"για να ξεκλειδώσετε πρόσθετο περιεχόμενο."

#: xmodule/seq_block.py:984
msgid ""
"A list summarizing what students should look forward to in this section."
msgstr ""
"Μια λίστα που συνοψίζει τι πρέπει να περιμένουν οι φοιτητές σε αυτή την "
"ενότητα."

#: xmodule/split_test_block.py:42
#, python-brace-format
msgid "Group ID {group_id}"
msgstr "Αναγνωριστικό ομάδας {group_id}"

#: xmodule/split_test_block.py:79
msgid "Not Selected"
msgstr "Μη επιλεγμένο"

#: xmodule/split_test_block.py:83
msgid "The display name for this component. (Not shown to learners)"
msgstr ""
"Το όνομα εμφάνισης για αυτό το στοιχείο. (Δεν εμφανίζεται στους μαθητές)"

#: xmodule/split_test_block.py:85
msgid "Content Experiment"
msgstr "Πείραμα περιεχομένου"

#: xmodule/split_test_block.py:96
msgid ""
"The configuration defines how users are grouped for this content experiment. "
"Caution: Changing the group configuration of a student-visible experiment "
"will impact the experiment data."
msgstr ""
"Η διαμόρφωση ορίζει τον τρόπο ομαδοποίησης των χρηστών για αυτό το πείραμα "
"περιεχομένου. Προσοχή: Η αλλαγή της διαμόρφωσης ομάδας ενός ορατού από τους "
"φοιτητές πειράματος θα επηρεάσει τα δεδομένα του πειράματος."

#: xmodule/split_test_block.py:98
msgid "Group Configuration"
msgstr "Διαμόρφωση ομάδας"

#: xmodule/split_test_block.py:109
msgid "Which child block students in a particular group_id should see"
msgstr ""
"Ποιο παιδικό μπλοκ θα πρέπει να βλέπουν οι μαθητές σε ένα συγκεκριμένο "
"group_id"

#: xmodule/split_test_block.py:295
#, python-brace-format
msgid "{group_name} (inactive)"
msgstr "{group_name} (ανενεργό)"

#: xmodule/split_test_block.py:636
msgid "The experiment is not associated with a group configuration."
msgstr "Το πείραμα δεν σχετίζεται με διαμόρφωση ομάδας."

#: xmodule/split_test_block.py:638
msgid "Select a Group Configuration"
msgstr "Επιλέξτε μια διαμόρφωση ομάδας"

#: xmodule/split_test_block.py:647
msgid ""
"The experiment uses a deleted group configuration. Select a valid group "
"configuration or delete this experiment."
msgstr ""
